    1:     def test_ngram_shorter_than_window_is_empty(self) -> None:
    1:         self.assertEqual(build_ngram_frequency("ab"), Counter())
       
    1:     def test_identical_short_documents_are_one(self) -> None:
    1:         self.assertAlmostEqual(calculate_similarity("甲", "甲"), 1.0)
       
    1:     def test_identical_documents_are_one(self) -> None:
    1:         self.assertAlmostEqual(calculate_similarity("abcdef", "abcdef"), 1.0)
       
    1:     def test_whitespace_only_changes_do_not_affect_result(self) -> None:
